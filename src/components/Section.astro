---
interface Props {
  id: string;
  title: string;
  intro?: string;
}
const { id, title, intro } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl scroll-mt-20 px-5 py-14 sm:px-8 sm:py-20">
  <h2 class="text-sm font-medium tracking-widest text-muted uppercase">{title}</h2>
  {intro && <p class="mt-2 max-w-2xl text-muted">{intro}</p>}
  <div class="mt-8"><slot /></div>
</section>
