---
/**
 * One card for both sections. `featured` (personal projects) gets more room for the visual.
 * Order of reading: company → title → outcome → metric → my part → tags → links.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Tags from './Tags.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  featured?: boolean;
  /** Spans both grid columns on desktop, with the visuals on the left. */
  wide?: boolean;
}
const { entry, featured = false, wide = false } = Astro.props;
const { title, company, myShare, outcome, metric, tags, highlights, visuals, links } = entry.data;

const linkList = [
  { label: 'Live demo', href: links.demo },
  { label: 'Code', href: links.repo },
  { label: 'Live site', href: links.live },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

const fmt = (d?: Date) => d?.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const multi = visuals.length > 1;
---

<article
  class:list={[
    'flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-colors hover:border-muted/50',
    wide && 'md:col-span-2 md:flex-row',
  ]}
>
  {visuals.length > 0 && (
    <div
      class:list={[
        'border-b border-line',
        multi && 'flex snap-x snap-mandatory gap-3 overflow-x-auto p-3',
        wide && 'md:w-1/2 md:shrink-0 md:self-center md:border-r md:border-b-0',
      ]}
      tabindex={multi ? 0 : undefined}
      aria-label={multi ? `${title} screenshots, scroll sideways` : undefined}
    >
      {visuals.map((v) => (
        <figure class={multi ? 'w-[85%] shrink-0 snap-start' : ''}>
          <Image
            src={v.src}
            alt={v.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 480px, 100vw"
            class={`h-auto w-full ${multi ? 'rounded-lg border border-line' : ''}`}
          />
          {(v.caption || v.capturedOn) && (
            <figcaption class={`pt-2 text-xs text-muted ${multi ? '' : 'px-5'}`}>
              {[v.caption, v.capturedOn && `captured ${fmt(v.capturedOn)}`].filter(Boolean).join(' · ')}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )}

  <div class={`flex flex-1 flex-col gap-4 ${featured ? 'p-6 sm:p-8' : 'p-5 sm:p-6'}`}>
    <header>
      {company && <p class="text-xs font-medium tracking-wider text-muted uppercase">{company}</p>}
      <h3 class={`mt-1 font-semibold tracking-tight ${featured ? 'text-2xl' : 'text-xl'}`}>{title}</h3>
    </header>

    <p class="text-pretty">{outcome}</p>

    {metric && (
      <p class="border-l-2 border-accent pl-3 text-sm font-medium">{metric}</p>
    )}

    <p class="text-sm text-muted">
      <span class="font-medium text-fg">My part: </span>{myShare}
    </p>

    {highlights && (
      <ul class="list-disc space-y-1 pl-5 text-sm text-muted marker:text-accent">
        {highlights.map((h) => <li>{h}</li>)}
      </ul>
    )}

    <div class="mt-auto flex flex-col gap-4 pt-2">
      <Tags tags={tags} />
      {linkList.length > 0 && (
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
          {linkList.map((l) => (
            <li>
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 underline decoration-line underline-offset-4 transition-colors hover:decoration-accent"
              >
                {l.label} <Icon name="arrow-up-right" class="size-3.5" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</article>
